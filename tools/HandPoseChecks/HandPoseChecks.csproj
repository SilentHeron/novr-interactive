    <Compile Include="../../NOVR/MotionControls/ControllerHardwareProfile.cs" Link="ControllerHardwareProfile.cs" />
    <Compile Include="../../NOVR/MotionControls/Fs20HandPoses.cs" Link="Fs20HandPoses.cs" />
    <Compile Include="../../NOVR/MotionControls/CollectiveHandPoses.cs" Link="CollectiveHandPoses.cs" />
    <Compile Include="../../NOVR/MotionControls/FlightControlMath.cs" Link="FlightControlMath.cs" />
    <Compile Include="../../NOVR/MotionControls/ArmPoseMath.cs" Link="ArmPoseMath.cs" />
    <Compile Include="../../NOVR/MotionControls/ArmReachMath.cs" Link="ArmReachMath.cs" />
    <EmbeddedResource Include="../../NOVR/Assets/Glove-left.json" LogicalName="NOVR.Glove.left.json" />
    <EmbeddedResource Include="../../NOVR/Assets/Glove-right.json" LogicalName="NOVR.Glove.right.json" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
