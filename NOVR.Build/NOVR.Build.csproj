<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SkipNuclearOptionReferences>true</SkipNuclearOptionReferences>
    <IsPackable>false</IsPackable>
    <EnableDefaultItems>false</EnableDefaultItems>
    <ReleasePackageDistDir>$(MSBuildThisFileDirectory)../dist</ReleasePackageDistDir>
    <ReleasePackagePath>$(ReleasePackageDistDir)/NOVR.zip</ReleasePackagePath>
    <ReleasePackageSourceDir>$(GameLayoutOutputDir)/BepInEx</ReleasePackageSourceDir>
    <ReleasePackageStagingDir>$(MSBuildThisFileDirectory)obj/release-package</ReleasePackageStagingDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NOVR.Build.props" />
    <None Include="NOVR.Build.targets" />
    <None Include="NOVR.Sources.props" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../NOVR/NOVR.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../NOVR.Patcher/NOVR.Patcher.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CreateReleaseZip" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <MakeDir Directories="$(ReleasePackageDistDir)" />
    <WriteLinesToFile Condition="'$(NovrReleaseVersion)' != ''"
                      File="$(ReleasePackageSourceDir)/plugins/NOVR/version.txt"
                      Lines="$(NovrReleaseVersion)" Overwrite="true" />
    <RemoveDir Directories="$(ReleasePackageStagingDir)" />
    <ItemGroup>
      <ReleasePluginFiles Include="$(ReleasePackageSourceDir)/plugins/NOVR/**/*" />
      <ReleasePatcherFiles Include="$(ReleasePackageSourceDir)/patchers/NOVR/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(ReleasePluginFiles)"
          DestinationFiles="@(ReleasePluginFiles->'$(ReleasePackageStagingDir)/plugins/NOVR/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(ReleasePatcherFiles)"
          DestinationFiles="@(ReleasePatcherFiles->'$(ReleasePackageStagingDir)/patchers/NOVR/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../README.md;$(MSBuildThisFileDirectory)../LICENSE;$(MSBuildThisFileDirectory)../docs/THIRD_PARTY_NOTICES.md"
          DestinationFolder="$(ReleasePackageStagingDir)" />
    <Delete Files="$(ReleasePackagePath)" />
    <ZipDirectory SourceDirectory="$(ReleasePackageStagingDir)" DestinationFile="$(ReleasePackagePath)" Overwrite="true" />
    <GetFileHash Files="$(ReleasePackagePath)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="ReleasePackageHash" />
    </GetFileHash>
    <WriteLinesToFile File="$(ReleasePackagePath).sha256"
                      Lines="@(ReleasePackageHash->'%(FileHash)  %(Filename)%(Extension)')"
                      Overwrite="true" />
  </Target>
</Project>
