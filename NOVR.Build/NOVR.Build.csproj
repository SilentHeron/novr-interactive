<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SkipNuclearOptionReferences>true</SkipNuclearOptionReferences>
    <IsPackable>false</IsPackable>
    <EnableDefaultItems>false</EnableDefaultItems>
    <ReleasePackageDistDir>$(MSBuildThisFileDirectory)../dist</ReleasePackageDistDir>
    <ReleasePackagePath>$(ReleasePackageDistDir)/NOVR.zip</ReleasePackagePath>
    <ReleasePackageSourceDir>$(GameLayoutOutputDir)/BepInEx</ReleasePackageSourceDir>
    <ReleasePackageStagingDir>$(MSBuildThisFileDirectory)obj/release-package</ReleasePackageStagingDir>
    <PackageValidationBuildDir Condition="'$(PackageValidationBuildDir)' == ''">$(MSBuildThisFileDirectory)obj/package-validation</PackageValidationBuildDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NOVR.Build.props" />
    <None Include="NOVR.Build.targets" />
    <None Include="NOVR.Sources.props" />
    <None Include="ValidatePackageVersion.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- These single-target projects supply package files, not assemblies for this build tool. -->
    <ProjectReference Include="../NOVR/NOVR.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="../NOVR.Patcher/NOVR.Patcher.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <UsingTask TaskName="ValidatePackageVersion" AssemblyFile="$(PackageValidationBuildDir)/bin/NOVR.Build.Tasks.dll" />

  <Target Name="BuildPackageValidation">
    <MSBuild Projects="$(MSBuildThisFileDirectory)Tasks/NOVR.Build.Tasks.csproj" Targets="Restore;Build"
             Properties="Configuration=$(Configuration);BaseIntermediateOutputPath=$(PackageValidationBuildDir)/obj/;OutputPath=$(PackageValidationBuildDir)/bin/;AppendTargetFrameworkToOutputPath=false" />
  </Target>

  <Target Name="CreateReleaseZip" AfterTargets="Build" DependsOnTargets="BuildPackageValidation" Condition="'$(Configuration)' == 'Release'">
    <!-- Never infer release identity from a previous staging directory. A normal
         build clears that directory; a direct target invocation may not. -->
    <Error Condition="!Exists('$(ReleasePackageSourceDir)/plugins/NOVR/NOVR.dll')"
           Text="Cannot package NOVR: staged plugins/NOVR/NOVR.dll is missing. Build the Release projects first." />
    <Error Condition="!Exists('$(ReleasePackageSourceDir)/patchers/NOVR/NOVR.Patcher.dll')"
           Text="Cannot package NOVR: staged patchers/NOVR/NOVR.Patcher.dll is missing. Build the Release projects first." />
    <Error Condition="'$(IncludeFixedFoveationNative)' != 'true' And Exists('$(ReleasePackageSourceDir)/plugins/NOVR/Native/NovrFoveation.dll')"
           Text="Cannot package NOVR: a staged fixed-foveation native backend requires -p:IncludeFixedFoveationNative=true. Rebuild without the flag to remove stale native output, or explicitly opt into an experimental package." />
    <Error Condition="'$(IncludeFixedFoveationNative)' == 'true' And (!Exists('$(ReleasePackageSourceDir)/plugins/NOVR/Native/NovrFoveation.dll') Or !Exists('$(ReleasePackageSourceDir)/plugins/NOVR/Native/NVIDIA-NVAPI-LICENSE.txt') Or !Exists('$(ReleasePackageSourceDir)/plugins/NOVR/Native/Unity-NativePlugin-LICENSE.txt') Or !Exists('$(ReleasePackageSourceDir)/plugins/NOVR/Native/THIRD-PARTY-NOTICES.txt'))"
           Text="Cannot package NOVR: IncludeFixedFoveationNative=true requires the staged native backend and its NVIDIA and Unity licenses. Build the Release projects with that flag first." />
    <ValidatePackageVersion PluginFile="$(ReleasePackageSourceDir)/plugins/NOVR/NOVR.dll"
                            PatcherFile="$(ReleasePackageSourceDir)/patchers/NOVR/NOVR.Patcher.dll"
                            SourceFile="$(MSBuildThisFileDirectory)../NOVR/NOVRPlugin.cs"
                            RequestedVersion="$(NovrReleaseVersion)">
      <Output TaskParameter="ReleaseVersion" PropertyName="_ValidatedReleaseVersion" />
    </ValidatePackageVersion>
    <MakeDir Directories="$(ReleasePackageDistDir)" />
    <WriteLinesToFile File="$(ReleasePackageSourceDir)/plugins/NOVR/version.txt"
                      Lines="$(_ValidatedReleaseVersion)" Overwrite="true" />
    <RemoveDir Directories="$(ReleasePackageStagingDir)" />
    <ItemGroup>
      <ReleasePluginFiles Include="$(ReleasePackageSourceDir)/plugins/NOVR/**/*" />
      <ReleasePatcherFiles Include="$(ReleasePackageSourceDir)/patchers/NOVR/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(ReleasePluginFiles)"
          DestinationFiles="@(ReleasePluginFiles->'$(ReleasePackageStagingDir)/plugins/NOVR/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(ReleasePatcherFiles)"
          DestinationFiles="@(ReleasePatcherFiles->'$(ReleasePackageStagingDir)/patchers/NOVR/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../README.md;$(MSBuildThisFileDirectory)../LICENSE;$(MSBuildThisFileDirectory)../docs/THIRD_PARTY_NOTICES.md"
          DestinationFolder="$(ReleasePackageStagingDir)" />
    <Delete Files="$(ReleasePackagePath)" />
    <ZipDirectory SourceDirectory="$(ReleasePackageStagingDir)" DestinationFile="$(ReleasePackagePath)" Overwrite="true" />
    <GetFileHash Files="$(ReleasePackagePath)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="ReleasePackageHash" />
    </GetFileHash>
    <WriteLinesToFile File="$(ReleasePackagePath).sha256"
                      Lines="@(ReleasePackageHash->'%(FileHash)  %(Filename)%(Extension)')"
                      Overwrite="true" />
  </Target>
</Project>
